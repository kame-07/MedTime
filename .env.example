# LINE Developers Console > Messaging API チャネルから取得した値を設定する
CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
CHANNEL_SECRET=your_channel_secret_here

# スケジュールの基準タイムゾーン
TIMEZONE=Asia/Tokyo

# 「いいえ」または無返答のときに再確認するまでの待ち時間(分)
RETRY_INTERVAL_MINUTES=5

# 無返答タイムアウトの扱い
#   immediate = 5分間無返答ならその時点で即再送(既定)
#   delayed   = 5分間無返答のあと、さらに RETRY_INTERVAL_MINUTES 待ってから再送
TIMEOUT_BEHAVIOR=immediate

# 1回の服薬確認あたりの最大再送回数(0 = 無制限。「はい」が来るまで送り続ける)
MAX_RETRY_COUNT=0

# 予定・状態の保存先
DATA_FILE=data/schedules.json

# Webhookサーバーの待ち受けポート
PORT=5000
